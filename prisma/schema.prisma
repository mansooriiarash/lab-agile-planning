generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }
model SprintSnapshot { id String @id @default(cuid()) name String sprintName String? reportDate DateTime sourceFileName String? items SprintItem[] baseComparisons SnapshotComparison[] @relation("BaseSnapshot") currentComparisons SnapshotComparison[] @relation("CurrentSnapshot") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model SprintItem { id String @id @default(cuid()) snapshotId String issueKey String? title String description String? team String? stakeholderDeputy String? stakeholderUnit String? businessArea String? valueOwner String? requestType String? priority String? storyPoints Float? status String? previousStatusText String? assignee String? reporter String? dueDate DateTime? labels String? isBlocked Boolean @default(false) blockerReason String? notes String? rawJson String? snapshot SprintSnapshot @relation(fields:[snapshotId], references:[id], onDelete:Cascade) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([snapshotId]) @@index([issueKey]) }
model ColumnMappingProfile { id String @id @default(cuid()) name String @unique mappingJson String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model SnapshotComparison { id String @id @default(cuid()) baseSnapshotId String currentSnapshotId String summaryJson String baseSnapshot SprintSnapshot @relation("BaseSnapshot", fields:[baseSnapshotId], references:[id], onDelete:Cascade) currentSnapshot SprintSnapshot @relation("CurrentSnapshot", fields:[currentSnapshotId], references:[id], onDelete:Cascade) changes ChangeRecord[] createdAt DateTime @default(now()) @@index([baseSnapshotId,currentSnapshotId]) }
model ChangeRecord { id String @id @default(cuid()) comparisonId String issueKey String changeType String fieldName String? oldValue String? newValue String? severity String analysisText String? comparison SnapshotComparison @relation(fields:[comparisonId], references:[id], onDelete:Cascade) createdAt DateTime @default(now()) @@index([comparisonId]) @@index([changeType]) }
